# Korea Investment & Securities API Configuration
KIS_APP_KEY=your_app_key_here
KIS_APP_SECRET=your_app_secret_here
KIS_ACCOUNT_NO=your_account_number
KIS_ACCOUNT_CODE=01  # Usually 01 for regular accounts

# Discord Bot Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_CHANNEL_ID=your_channel_id_number

# Trading Parameters (Optional - defaults provided)
STOP_LOSS=-1.5              # Stop loss percentage (negative)
QUICK_PROFIT=2.0            # Quick profit target percentage
TARGET_PROFIT=5.0           # Final profit target percentage
TRAILING_START=4.0          # Trailing stop activation percentage
MAX_ACTIVE_TRADES=3         # Maximum concurrent positions
ONE_TIME_BUY_AMT=1500000    # Single buy amount in KRW

# Ollama AI Configuration (Optional)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# Debug Mode (Optional)
DEBUG_MODE=false            # Set to 'true' to enable debug logging
